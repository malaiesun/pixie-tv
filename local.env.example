# Copy to local.env (git-ignored) and fill in your own values.
# TV_IP          the TV's address on your network (give it a DHCP reservation in the router)
# HA_URL         your Home Assistant
# HA_ADB_PLAYER  the media_player entity the HA "Android Debug Bridge" integration made for the TV
TV_IP=192.168.1.50
HA_URL=http://homeassistant.local:8123
HA_ADB_PLAYER=media_player.android_tv_192_168_1_50
